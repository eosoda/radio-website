rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Rádio Vida FM Security Rules
     * 
     * Core Philosophy:
     * Authentication protects the admin panel. In this MVP version, any authenticated 
     * user is granted administrative rights to manage the radio content.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description For MVP, any authenticated user can manage content. */
    function isAdmin() {
      return isSignedIn();
    }

    /** @description Verifies a document exists and the user is an administrator. */
    function isExistingAdminWrite() {
      return isAdmin() && resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the global application configuration.
     */
    match /config/main {
      allow get: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the radio program schedule.
     */
    match /programs/{programId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for managing administrative roles (kept for future scaling).
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // Only via Console/Admin SDK
    }
  }
}